{
  // Solelis : site Next.js servi par un Worker Cloudflare (adaptateur OpenNext).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solelis",
  "main": "worker.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Adresses servies directement par ce Worker (www redirige vers solelis.com, voir worker.ts).
  "routes": [
    { "pattern": "solelis.com", "custom_domain": true },
    { "pattern": "www.solelis.com", "custom_domain": true }
  ],
  // Base des fiches (D1, juridiction UE). Schéma : dossier migrations/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "solelis",
      "database_id": "b094671a-a235-449a-a06d-4d311c7a3988",
      "migrations_dir": "migrations"
    }
  ],
  // Identifiant de la version déployée (clé du cache des pages Conseils, voir worker.ts).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Rappels email chaque jour à 7 h (UTC).
  "triggers": { "crons": ["0 7 * * *"] },
  "observability": { "enabled": true }
}
