{
  "name": "solelis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "conseils": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generer-conseils.ts",
    "veille": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/articles-veille.ts",
    "dates": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dates-pages.ts",
    "predev": "npm run conseils && npm run veille && npm run dates",
    "dev": "next dev",
    "prebuild": "npm run conseils && npm run veille && npm run dates",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "pretest": "npm run conseils && npm run veille && npm run dates",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "next": "^16.4.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^4.0.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.29"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^2.1.4",
    "@opennextjs/cloudflare": "^1.20.12",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^29.1.1",
    "marked": "^16.4.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0",
    "vitest": "^4.1.7",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=22"
  }
}
